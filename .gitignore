# ---------- 依赖与构建产物 ----------
node_modules/
dist/
web/dist/
.vite/

# ---------- 运行时数据 ----------
# SQLite 数据库文件（首次运行由 npm run init:db 自动生成）
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
# 用户上传的图片
server/uploads/
# 用户本地环境变量（模板见 .env.example，禁止提交真实密钥）
.env
.env.local
server/.env
web/.env.local

# ---------- 日志与临时文件 ----------
*.log
logs/
npm-debug.log*
.DS_Store
Thumbs.db
# 隧道脚本自动生成的「当前公网网址」纯文本（每次重连都会变，不入库）
当前网址.txt

# ---------- 本地工具（非项目代码） ----------
.tools/
.npm-cache/
# 可选隧道客户端的下载目录（cloudflared 等，体积大且下载不稳定）
tools/bin/

# ---------- 编辑器 ----------
.idea/
.vscode/*
!.vscode/extensions.json
# 隧道脚本生成的公网地址（每次重连都变，不入库）
tools/tunnel-url.txt
