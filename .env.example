# ============================================================
# 智练 SmartFit 环境变量模板
# 使用方法：复制本文件为 server/.env，按需修改后保存
#   Windows:  copy .env.example server\.env
#   macOS/Linux: cp .env.example server/.env
# 说明：所有变量都有内置默认值，不配置也能启动（AI 会降级到本地规则引擎）
# ============================================================

# ---------- 服务基础配置 ----------
# 后端监听端口
PORT=3000
# 监听地址：默认 0.0.0.0（容器/Render 必须如此，否则 IPv4 客户端连不上）
HOST=0.0.0.0
# 运行环境：development | production
NODE_ENV=development
# 业务时区：「今天」按这个时区算，与服务器所在时区无关（云平台默认 UTC）
APP_TZ=Asia/Shanghai
# JWT 签名密钥（生产环境务必替换为随机长字符串）
JWT_SECRET=smartfit-dev-secret-please-change-in-production
# JWT 有效期（登录态以 HttpOnly Cookie 形式下发，前端拿不到明文 token）
JWT_EXPIRES_IN=7d

# ---------- 数据库 ----------
# SQLite 数据文件路径（相对 server 目录），Node 22.5+ 内置 node:sqlite，无需安装数据库
DB_FILE=data/smartfit.db
# 演示数据保鲜：启动时若演示数据已过期，自动整体平移到今天（off 可关闭）
DEMO_AUTO_SHIFT=on

# ---------- 上传限制（拍照识热量） ----------
# 请求体上限（base64 图片会比原图大约 1.37 倍）
UPLOAD_MAX_BODY=20mb
# 单张图片解码后的上限（MB）
UPLOAD_MAX_IMAGE_MB=12
# 最小体积字节数：只拦空文件/明显损坏，纯色小图也允许上传（交给模型判定）
UPLOAD_MIN_IMAGE_BYTES=64

# ---------- 大模型（OpenAI 兼容协议） ----------
# 留空则自动进入「本地规则引擎」降级模式，所有 AI 功能仍可正常演示
# 推荐：DeepSeek / 通义千问 / Moonshot / OpenAI 任意 OpenAI 兼容服务
AI_API_KEY=
# 例如 https://api.deepseek.com/v1 或 https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=https://api.deepseek.com/v1
# 文本模型
AI_MODEL=deepseek-chat
# 多模态（图片理解）模型；配置后开启「拍照识别食物热量」，留空则该入口不可用
# DeepSeek：填 deepseek-chat 即可（同一 Key 支持图像输入，无需另外申请）
AI_VISION_MODEL=
# 单次请求超时（毫秒）
AI_TIMEOUT_MS=45000
# 识图单独的超时（毫秒）：验收要求「任意输入 15s 内必返回」，超时后走优雅降级而不是 500
AI_VISION_TIMEOUT_MS=15000
# 采样温度（结构化输出场景建议 0.3~0.7）
AI_TEMPERATURE=0.6

# ---------- RAG / 缓存 / 限流 ----------
# 知识库检索返回条数
RAG_TOP_K=6
# 是否启用语义缓存（相同画像 + 相同目标直接复用结果）
AI_CACHE_ENABLED=true
# AI 接口每用户每分钟最大请求数
AI_RATE_LIMIT_PER_MIN=20

# ---------- 前端（web/.env.local 可选覆盖）----------
# 前端请求后端的地址；开发环境留空即使用 Vite 代理到 http://localhost:3000
VITE_API_BASE=
